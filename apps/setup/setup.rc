#pragma code_page(65001)
#include <winver.h>
// Instalator: ikona + opis programu. Programy i tapety (RCDATA) — setup_payload.rc generowany przez CMake w folderze builda.
1 ICON "../../res/setup.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041504B0"
        BEGIN
            VALUE "FileDescription", "Instalator Veyry"
            VALUE "ProductName", "Veyra"
            VALUE "FileVersion", "1.2"
            VALUE "OriginalFilename", "VeyraSetup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0415, 1200
    END
END
