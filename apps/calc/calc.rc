#pragma code_page(65001)
#include <winver.h>
// Kalkulator: ikona (dock, Alt+Tab, panel aplikacji) + opis programu (nazwa w docku)
1 ICON "../../res/calculator.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,5,2
PRODUCTVERSION 1,1,5,2
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041504B0"
        BEGIN
            VALUE "FileDescription", "Kalkulator"
            VALUE "ProductName", "Exploder"
            VALUE "FileVersion", "1.1.5.2"
            VALUE "OriginalFilename", "exploder-calc.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0415, 1200
    END
END
