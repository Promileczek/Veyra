#pragma code_page(65001)
#include <winver.h>
// Sklep: ikona (dock, Alt+Tab, panel aplikacji) + opis programu (nazwa w docku)
1 ICON "../../res/store.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041504B0"
        BEGIN
            VALUE "FileDescription", "Sklep"
            VALUE "ProductName", "Exploder"
            VALUE "FileVersion", "1.0"
            VALUE "OriginalFilename", "exploder-store.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0415, 1200
    END
END
